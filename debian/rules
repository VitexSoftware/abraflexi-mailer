#!/usr/bin/make -f

PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/~.*//')
PKG_SOURCE  := $(shell jq -r '.name' composer.json)

%:
	dh $@ --with phpcomposer

override_dh_install:
	mkdir -p debian/tmp/
	jq '.version = "'`dpkg-parsechangelog | sed -n 's/^Version: //p'| sed 's/~.*//'`'"'  composer.json |sponge debian/tmp/composer.json
	dh_install
	sed -i "s|: 'unknown'|: '$(PKG_SOURCE)'|" \
		debian/abraflexi-mailer/usr/lib/abraflexi-mailer/autoload.php
	sed -i "s|: '0.0.0'|: '$(PKG_VERSION)'|" \
		debian/abraflexi-mailer/usr/lib/abraflexi-mailer/autoload.php
	# Install Debian autoloader
	sed -i -e 's/..\/vendor/\/usr\/lib\/abraflexi-mailer/'    debian/abraflexi-mailer/usr/lib/abraflexi-mailer/*.php
	sed -i -e 's/..\/.env//'                                  debian/abraflexi-mailer/usr/lib/abraflexi-mailer/*.php
	sed -i -e 's/\.\.\/i18n/\/usr\/share\/locale/g'           debian/abraflexi-mailer/usr/lib/abraflexi-mailer/*.php
	for app in multiflexi/*.multiflexi.app.json; do \
		jq '.version = "$(PKG_VERSION)"' $$app > debian/multiflexi-abraflexi-mailer/usr/lib/abraflexi-mailer/$$app || exit 1; \
	done
