{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/schema/application.json",
  "schemaVersion": "3.4.0",
  "version": "1.4.0",
  "uuid": "c2feac3d-1351-48d3-a019-ecd0b102ef87",
  "name": {
    "en": "Payment Receipt Confirmation",
    "cs": "Potvrzení přijetí úhrady"
  },
  "description": {
    "en": "Send confirmation of payment receipt to the customer based on document ID",
    "cs": "Odeslání potvrzení o přijetí úhrady zákazníkovi na základě ID dokumentu"
  },
  "tags": [
    "AbraFlexi",
    "Mail",
    "Confirmation",
    "Payment"
  ],
  "homepage": "https://github.com/VitexSoftware/abraflexi-mailer/",
  "ociimage": "docker.io/vitexsoftware/abraflexi-mailer",
  "executable": "abraflexi-potvrzeni-prijeti-uhrady",
  "events": {
    "consumes": {
      "payment.received": {
        "description": {
          "en": "A payment was received and matched to a document; send the confirmation",
          "cs": "Byla přijata úhrada spárovaná s dokladem; odešli potvrzení"
        },
        "format": "json"
      }
    }
  },
  "consumes": {
    "matched_document": {
      "description": {
        "en": "One matched invoice code from a payment-matching job's result",
        "cs": "Jeden kód spárované faktury z výsledku párovacího jobu"
      },
      "format": "text",
      "required": true,
      "target": "DOCID"
    }
  },
  "environment": {
    "ABRAFLEXI_COMPANY": {
      "type": "string",
      "description": {
        "en": "AbraFlexi company code",
        "cs": "Kód společnosti v AbraFlexi"
      },
      "defval": "demo_de",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_LOGIN": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Login",
        "cs": "Přihlašovací jméno do AbraFlexi"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_PASSWORD": {
      "type": "password",
      "description": {
        "en": "AbraFlexi password",
        "cs": "Heslo pro AbraFlexi"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_URL": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Server URI",
        "cs": "URI adresa AbraFlexi serveru"
      },
      "defval": "https://demo.flexibee.eu:5434",
      "required": true,
      "category": "API"
    },
    "DOCID": {
      "type": "string",
      "description": {
        "en": "Document identifier (invoice code or numeric ID)",
        "cs": "Identifikátor dokumentu (kód faktury nebo číselné ID)"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "MAIL_FROM": {
      "type": "email",
      "description": {
        "en": "Sender email address",
        "cs": "E-mailová adresa odesílatele"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "MAIL_SIGNATURE": {
      "type": "text",
      "description": {
        "en": "Email signature text",
        "cs": "Text podpisu e-mailu"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "SEND_INFO_TO": {
      "type": "email",
      "description": {
        "en": "Send copy (Cc) to this address",
        "cs": "Odeslat kopii (Cc) na tuto adresu"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "Write log messages using",
        "cs": "Zapisovat zprávy do logu pomocí"
      },
      "defval": "console|syslog",
      "required": false,
      "category": "Behavior"
    },
    "APP_DEBUG": {
      "type": "bool",
      "description": {
        "en": "Show app version at startup",
        "cs": "Zobrazit verzi aplikace při spuštění"
      },
      "defval": "",
      "required": false,
      "category": "Behavior"
    },
    "MAIL_DSN": {
      "type": "password",
      "description": {
        "en": "Symfony Mailer DSN for sending mail (e.g. smtp://user:pass@host:port). Defaults to local sendmail if empty. Only use insecure options like verify_peer=0 for trusted internal/private relays; prefer peer_fingerprint to pin a self-signed cert instead of disabling TLS verification.",
        "cs": "DSN pro Symfony Mailer k odesílání pošty (např. smtp://user:pass@host:port). Pokud je prázdné, použije se lokální sendmail. Nezabezpečené volby jako verify_peer=0 používejte pouze pro důvěryhodné interní/privátní relaye; pro self-signed certifikát preferujte peer_fingerprint místo vypnutí ověřování TLS."
      },
      "defval": "",
      "required": false,
      "category": "Other"
    }
  },
  "exitCodes": {
    "0": {
      "description": {
        "en": "Success - confirmation sent",
        "cs": "Úspěch - potvrzení odesláno"
      },
      "severity": "success",
      "retry": false
    },
    "1": {
      "description": {
        "en": "Missing document ID",
        "cs": "Chybí identifikátor dokumentu"
      },
      "severity": "error",
      "retry": false
    },
    "2": {
      "description": {
        "en": "Failed to send confirmation email",
        "cs": "Nepodařilo se odeslat potvrzovací e-mail"
      },
      "severity": "error",
      "retry": true
    },
    "3": {
      "description": {
        "en": "Cannot read document from AbraFlexi",
        "cs": "Nelze přečíst dokument z AbraFlexi"
      },
      "severity": "error",
      "retry": true
    }
  },
  "requirements": [
    "Mail",
    "AbraFlexi"
  ]
}
