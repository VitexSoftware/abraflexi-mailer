{
  "$schema": "https://multiflexi.eu/schema/application.json",
  "schemaVersion": "3.4.0",
  "version": "1.0.0",
  "uuid": "bbefe4ed-a898-49c4-9b29-7ce8774b0683",
  "name": {
    "en": "Payment Receipt Confirmation (bank / cash desk)",
    "cs": "Potvrzení přijetí platby (banka / pokladna)"
  },
  "description": {
    "en": "Confirms a received payment (bank or cash desk record) to the customer, once, when the payer is known. The payment gets the label UHRADA_POTVRZENA. Takes DOCID and EVIDENCE (banka or pokladni-pohyb).",
    "cs": "Potvrdí zákazníkovi přijetí platby (záznam v bance či pokladně), jednou, ve chvíli, kdy je plátce znám. Platba dostane štítek UHRADA_POTVRZENA. Přijímá DOCID a EVIDENCE (banka nebo pokladni-pohyb)."
  },
  "tags": [
    "AbraFlexi",
    "Mail",
    "Confirmation",
    "Payment",
    "Bank",
    "Cash"
  ],
  "homepage": "https://github.com/VitexSoftware/abraflexi-mailer/",
  "ociimage": "docker.io/vitexsoftware/abraflexi-mailer",
  "executable": "abraflexi-potvrzeni-prijeti-platby",
  "events": {
    "consumes": {
      "payment.received": {
        "description": {
          "en": "Money came to the bank or the cash desk (insert or update of the record); confirm it to the payer when known",
          "cs": "Peníze přišly do banky nebo do pokladny (vložení či změna záznamu); potvrdit plátci, je-li znám"
        },
        "format": "json"
      }
    }
  },
  "environment": {
    "ABRAFLEXI_COMPANY": {
      "type": "string",
      "description": {
        "en": "AbraFlexi company code",
        "cs": "Kód společnosti v AbraFlexi"
      },
      "defval": "demo_de",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_LOGIN": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Login",
        "cs": "Přihlašovací jméno do AbraFlexi"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_PASSWORD": {
      "type": "password",
      "description": {
        "en": "AbraFlexi password",
        "cs": "Heslo pro AbraFlexi"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_URL": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Server URI",
        "cs": "URI adresa AbraFlexi serveru"
      },
      "defval": "https://demo.flexibee.eu:5434",
      "required": true,
      "category": "API"
    },
    "DOCID": {
      "type": "string",
      "description": {
        "en": "Payment record identifier (numeric ID or code) in the evidence given by EVIDENCE - mapped from recordid by the event processor",
        "cs": "Identifikátor záznamu platby (číselné ID nebo kód) v evidenci dané proměnnou EVIDENCE - mapováno z recordid procesorem událostí"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "MAIL_FROM": {
      "type": "email",
      "description": {
        "en": "Sender email address",
        "cs": "E-mailová adresa odesílatele"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "MAIL_SIGNATURE": {
      "type": "text",
      "description": {
        "en": "Email signature text",
        "cs": "Text podpisu e-mailu"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "SEND_INFO_TO": {
      "type": "email",
      "description": {
        "en": "Send copy (Cc) to this address",
        "cs": "Odeslat kopii (Cc) na tuto adresu"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "Write log messages using",
        "cs": "Zapisovat zprávy do logu pomocí"
      },
      "defval": "console|syslog",
      "required": false,
      "category": "Behavior"
    },
    "APP_DEBUG": {
      "type": "bool",
      "description": {
        "en": "Show app version at startup",
        "cs": "Zobrazit verzi aplikace při spuštění"
      },
      "defval": "",
      "required": false,
      "category": "Behavior"
    },
    "MAIL_DSN": {
      "type": "password",
      "description": {
        "en": "Symfony Mailer DSN for sending mail (e.g. smtp://user:pass@host:port). Defaults to local sendmail if empty. Only use insecure options like verify_peer=0 for trusted internal/private relays; prefer peer_fingerprint to pin a self-signed cert instead of disabling TLS verification.",
        "cs": "DSN pro Symfony Mailer k odesílání pošty (např. smtp://user:pass@host:port). Pokud je prázdné, použije se lokální sendmail. Nezabezpečené volby jako verify_peer=0 používejte pouze pro důvěryhodné interní/privátní relaye; pro self-signed certifikát preferujte peer_fingerprint místo vypnutí ověřování TLS."
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "EVIDENCE": {
      "type": "string",
      "description": {
        "en": "Evidence of the payment: banka or pokladni-pohyb",
        "cs": "Evidence platby: banka nebo pokladni-pohyb"
      },
      "defval": "banka",
      "required": false,
      "category": "API"
    }
  },
  "exitCodes": {
    "0": {
      "description": {
        "en": "Success - notification sent",
        "cs": "Úspěch - notifikace odeslána"
      },
      "severity": "success",
      "retry": false
    },
    "1": {
      "description": {
        "en": "Missing document ID",
        "cs": "Chybí identifikátor dokumentu"
      },
      "severity": "error",
      "retry": false
    },
    "2": {
      "description": {
        "en": "Failed to send notification email",
        "cs": "Nepodařilo se odeslat notifikační e-mail"
      },
      "severity": "error",
      "retry": true
    },
    "3": {
      "description": {
        "en": "Cannot read bank record from AbraFlexi",
        "cs": "Nelze přečíst bankovní záznam z AbraFlexi"
      },
      "severity": "error",
      "retry": true
    }
  },
  "requirements": [
    "Mail",
    "AbraFlexi"
  ]
}
