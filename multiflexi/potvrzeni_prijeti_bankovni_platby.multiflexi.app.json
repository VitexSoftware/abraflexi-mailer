{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/schema/application.json",
  "schemaVersion": "3.4.0",
  "version": "1.0.0",
  "uuid": "a7e3d1f2-4c89-4b5a-b8e6-9f2c3d4e5f60",
  "name": {
    "en": "Bank Payment Receipt Notification",
    "cs": "Potvrzení přijetí bankovní platby"
  },
  "description": {
    "en": "Notifies the customer that their bank payment was received but could not be automatically matched to an invoice (unknown variable symbol, underpayment, overpayment or AbraFlexi unavailability). Takes DOCID as a banka evidence record ID.",
    "cs": "Notifikuje zákazníka, že jeho bankovní platba byla přijata, ale nemohla být automaticky spárována s fakturou (neznámý variabilní symbol, nedoplatek, přeplatek nebo nedostupnost AbraFlexi). Přijímá DOCID jako ID záznamu v evidenci banka."
  },
  "tags": [
    "AbraFlexi",
    "Mail",
    "Confirmation",
    "Payment",
    "Bank"
  ],
  "homepage": "https://github.com/VitexSoftware/abraflexi-mailer/",
  "ociimage": "docker.io/vitexsoftware/abraflexi-mailer",
  "executable": "abraflexi-potvrzeni-prijeti-bankovni-platby",
  "events": {
    "consumes": {
      "payment.unmatched": {
        "description": {
          "en": "A bank or cash payment was received but could not be matched to an invoice; notify the customer",
          "cs": "Byla přijata bankovní nebo pokladní platba, kterou nešlo spárovat s fakturou; oznámit zákazníkovi"
        },
        "format": "json"
      }
    }
  },
  "environment": {
    "ABRAFLEXI_COMPANY": {
      "type": "string",
      "description": {
        "en": "AbraFlexi company code",
        "cs": "Kód společnosti v AbraFlexi"
      },
      "defval": "demo_de",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_LOGIN": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Login",
        "cs": "Přihlašovací jméno do AbraFlexi"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_PASSWORD": {
      "type": "password",
      "description": {
        "en": "AbraFlexi password",
        "cs": "Heslo pro AbraFlexi"
      },
      "defval": "winstrom",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_URL": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Server URI",
        "cs": "URI adresa AbraFlexi serveru"
      },
      "defval": "https://demo.flexibee.eu:5434",
      "required": true,
      "category": "API"
    },
    "DOCID": {
      "type": "string",
      "description": {
        "en": "Bank record identifier (banka evidence numeric ID or code) — mapped from recordid by event processor",
        "cs": "Identifikátor záznamu v evidenci banka (číselné ID nebo kód) — mapováno z recordid procesorem událostí"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "MAIL_FROM": {
      "type": "email",
      "description": {
        "en": "Sender email address",
        "cs": "E-mailová adresa odesílatele"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "MAIL_SIGNATURE": {
      "type": "text",
      "description": {
        "en": "Email signature text",
        "cs": "Text podpisu e-mailu"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "SEND_INFO_TO": {
      "type": "email",
      "description": {
        "en": "Send copy (Cc) to this address",
        "cs": "Odeslat kopii (Cc) na tuto adresu"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "EASE_SMTP": {
      "type": "string",
      "description": {
        "en": "Configuration string for Pear_Mail",
        "cs": "Konfigurační řetězec pro Pear_Mail"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "Write log messages using",
        "cs": "Zapisovat zprávy do logu pomocí"
      },
      "defval": "console|syslog",
      "required": false,
      "category": "Behavior"
    },
    "APP_DEBUG": {
      "type": "bool",
      "description": {
        "en": "Show app version at startup",
        "cs": "Zobrazit verzi aplikace při spuštění"
      },
      "defval": "",
      "required": false,
      "category": "Behavior"
    }
  },
  "exitCodes": {
    "0": {
      "description": {
        "en": "Success - notification sent",
        "cs": "Úspěch - notifikace odeslána"
      },
      "severity": "success",
      "retry": false
    },
    "1": {
      "description": {
        "en": "Missing document ID",
        "cs": "Chybí identifikátor dokumentu"
      },
      "severity": "error",
      "retry": false
    },
    "2": {
      "description": {
        "en": "Failed to send notification email",
        "cs": "Nepodařilo se odeslat notifikační e-mail"
      },
      "severity": "error",
      "retry": true
    },
    "3": {
      "description": {
        "en": "Cannot read bank record from AbraFlexi",
        "cs": "Nelze přečíst bankovní záznam z AbraFlexi"
      },
      "severity": "error",
      "retry": true
    }
  },
  "requirements": [
    "Mail",
    "AbraFlexi"
  ]
}
